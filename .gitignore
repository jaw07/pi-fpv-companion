__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Model weights — large binaries, do not commit
*.rpk
*.ncnn
# EXCEPT the models a config actually deploys — they ship with the code so a clean
# flash + clone is self-contained. camera/imx500.py raises at startup if the .rpk is
# missing, so an untracked-but-configured model is a boot failure on a fresh Pi.
# KEEP IN SYNC with imx500_model in config/*.yaml.
!models/imx500_network_yolo11n_visdrone416_pp.rpk
!models/imx500_network_yolo11n_416_pp.rpk
# Other export-pipeline build artifacts stay ignored.
models/*.zip
models/*best*.pt
models/*_labels.txt
*.param
*.bin
*.onnx
*.pt

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local config overrides
config/local.yaml
config/*.local.yaml
